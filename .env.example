# Jira credentials
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USER=you@yourcompany.com
JIRA_TOKEN=your_jira_api_token
JIRA_WEBHOOK_SECRET=         # optional – shared secret for HMAC signature verification

# GitHub credentials
GITHUB_TOKEN=ghp_yourtoken
GITHUB_REPO=org/repo-name    # e.g. myorg/my-repo
REPO_LOCAL_PATH=/absolute/path/to/local/clone

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o          # or gpt-4-turbo, gpt-3.5-turbo, etc.

# App behaviour (optional – defaults shown)
BASE_BRANCH=main
MAX_CONTEXT_FILES=10         # max repo files sent to AI for code-gen
MAX_FILE_CHARS=8000          # chars per file sent to AI
MAX_README_CHARS=4000        # chars of README sent to AI
